<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Figura Obscura spawns ffmpeg as a child process. Under the hardened
         runtime a signed parent may only launch signed children unless this is
         set, and the bundled ffmpeg is signed ad-hoc at best. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Model downloads. Everything else is offline. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
